# Hermes Live Read-Only runtime environment — Phase 15 (TEMPLATE, placeholders only).
#
# Copy to /opt/hermes/secrets/hermes.live_readonly.env on the host and `chmod 600` it.
# NEVER commit a populated copy.
#
# SCOPE (roadmap Phase 15 — "Live-Money Readiness, Not Deployment"):
#   This profile reads LIVE market/account data for reconciliation and monitoring ONLY.
#   It submits NOTHING. There is no live order submission in any current roadmap phase;
#   live tiny-submit remains an explicit future human decision after paper has a boring,
#   clean record. The fail-closed AppConfig validators reject any submit flag here.

# --- deployment profile (fail-closed; do not relax) -------------------------
APP_ENV=live_readonly
BROKER_MODE=live_readonly
SUBMISSION_ENABLED=false
PAPER_SUBMIT_ENABLED=false
LIVE_SUBMIT_ENABLED=false

# --- feature flags ----------------------------------------------------------
# Live read-only reconciliation reads market data and may run the gateway for
# validation/observability, but generates no candidates to act on and mints no order
# tickets to submit. These are not constrained by the AppConfig live_readonly invariants
# (which only pin broker mode + the three submit flags); they are set conservatively here
# for a read-only reconciliation deploy.
MARKET_DATA_ENABLED=true
CANDIDATE_GENERATION_ENABLED=false
GATEWAY_ENABLED=true
ORDER_TICKETING_ENABLED=false

# --- paths ------------------------------------------------------------------
HERMES_AUDIT_DB=/opt/hermes/data/audit.db
HERMES_HEARTBEAT_FILE=/opt/hermes/logs/heartbeat.txt

# --- read-only credential NAME placeholders (leave empty in this template) ---
# A live read-only deploy uses READ-ONLY market-data and READ-ONLY broker/account
# credentials only. Populate real values ONLY on the host secrets file (chmod 600),
# NEVER in git, and ONLY after the §11 secondary-feed certification and the Phase 15
# readiness checklist (docs/LIVE_MONEY_READINESS_CHECKLIST.md) are complete. No
# order-submission scope may ever be granted to these credentials.
POLYGON_API_KEY=
BROKER_API_KEY=
BROKER_API_SECRET=
