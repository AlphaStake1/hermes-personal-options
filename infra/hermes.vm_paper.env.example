# Hermes VM Paper runtime environment — Phase 12 (TEMPLATE, placeholders only).
#
# Copy to /opt/hermes/secrets/hermes.vm_paper.env on the host and `chmod 600` it.
# NEVER commit a populated copy.
#
# PAPER MODE ONLY. This profile arms the PAPER submit lane (simulated orders) and
# requires per-order human confirmation. It must NEVER carry live broker
# credentials and must NEVER enable live submission — both are rejected by
# config.AppConfig, services.paper_cycle, and brokers.LocalPaperBroker.

# --- deployment profile (fail-closed; do not relax) -------------------------
APP_ENV=vm_paper
BROKER_MODE=paper
SUBMISSION_ENABLED=true
PAPER_SUBMIT_ENABLED=true
LIVE_SUBMIT_ENABLED=false
MARKET_DATA_ENABLED=true
CANDIDATE_GENERATION_ENABLED=true
GATEWAY_ENABLED=true
ORDER_TICKETING_ENABLED=true

# --- paper policy knobs (brokers.PaperBrokerConfig; deterministic, enforced) -
# These are NOT advisory: max-contracts, limit-only, and per-order human
# confirmation are enforced in code by LocalPaperBroker at submit time, and the
# paper cycle (P1) refuses to run unless PAPER_REQUIRE_HUMAN_CONFIRM=true.
PAPER_MAX_CONTRACTS=1
PAPER_ALLOWED_UNDERLYINGS=XSP
PAPER_LIMIT_ONLY=true
PAPER_REQUIRE_HUMAN_CONFIRM=true

# --- paths ------------------------------------------------------------------
HERMES_AUDIT_DB=/opt/hermes/data/audit.db
HERMES_HEARTBEAT_FILE=/opt/hermes/logs/heartbeat.txt

# --- loop intervals (seconds) ----------------------------------------------
PAPER_CYCLE_INTERVAL_SECONDS=300
REPORT_INTERVAL_SECONDS=3600
HEARTBEAT_MAX_AGE_SECONDS=600

# --- read-only market-data secret NAME placeholder --------------------------
# Populate a real read-only key ONLY after a certified feed is approved
# (Constitution §11). This line documents the required secret name; not a value.
POLYGON_API_KEY=
