# Hermes VM Shadow runtime environment — Phase 11 (TEMPLATE, placeholders only).
#
# Copy to /opt/hermes/secrets/hermes.vm_shadow.env on the host and `chmod 600` it.
# NEVER commit a populated copy. No broker credentials belong on a shadow droplet.

# --- deployment profile (fail-closed; do not relax) -------------------------
APP_ENV=vm_shadow
BROKER_MODE=none
SUBMISSION_ENABLED=false
PAPER_SUBMIT_ENABLED=false
LIVE_SUBMIT_ENABLED=false
MARKET_DATA_ENABLED=true
CANDIDATE_GENERATION_ENABLED=true
GATEWAY_ENABLED=true
ORDER_TICKETING_ENABLED=true

# --- paths (match docs/DIGITALOCEAN_SETUP_GUIDE_FOR_GEMINI.md) --------------
HERMES_AUDIT_DB=/opt/hermes/data/audit.db
HERMES_HEARTBEAT_FILE=/opt/hermes/logs/heartbeat.txt

# --- loop intervals (seconds) ----------------------------------------------
SHADOW_CYCLE_INTERVAL_SECONDS=300
REPORT_INTERVAL_SECONDS=3600
HEARTBEAT_MAX_AGE_SECONDS=600

# --- read-only market-data secret NAME placeholder (leave empty in shadow) --
# Populate a real read-only key ONLY after a certified feed is approved
# (Constitution §11). Live data stays paper-only until then; shadow does not
# require it. This line documents the required secret name; it is not a value.
POLYGON_API_KEY=
