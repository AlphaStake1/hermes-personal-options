# Hermes local development defaults.
# Copy to .env only for local use. Never commit real broker credentials or API keys.

APP_ENV=local
BROKER_MODE=paper
SUBMISSION_ENABLED=false
PAPER_SUBMIT_ENABLED=false
LIVE_SUBMIT_ENABLED=false
MARKET_DATA_ENABLED=false
CANDIDATE_GENERATION_ENABLED=false
GATEWAY_ENABLED=true
ORDER_TICKETING_ENABLED=true
PAPER_MAX_CONTRACTS=1
PAPER_ALLOWED_UNDERLYINGS=XSP
PAPER_LIMIT_ONLY=true
PAPER_REQUIRE_HUMAN_CONFIRM=true

# Future read-only data integrations may require local-only values.
POLYGON_API_KEY=
BROKER_API_KEY=
BROKER_API_SECRET=
