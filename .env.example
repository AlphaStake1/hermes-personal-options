# Hermes local development defaults.
# Copy to .env only for local use. Never commit real broker credentials or API keys.

APP_ENV=local
BROKER_MODE=paper
SUBMISSION_ENABLED=false
PAPER_SUBMIT_ENABLED=false
LIVE_SUBMIT_ENABLED=false
MARKET_DATA_ENABLED=false
CANDIDATE_GENERATION_ENABLED=false
GATEWAY_ENABLED=true
ORDER_TICKETING_ENABLED=true
PAPER_MAX_CONTRACTS=1
PAPER_ALLOWED_UNDERLYINGS=XSP
PAPER_LIMIT_ONLY=true
PAPER_REQUIRE_HUMAN_CONFIRM=true

# Future read-only data integrations may require local-only values.
POLYGON_API_KEY=
BROKER_API_KEY=
BROKER_API_SECRET=

# --- Phase 11: VM shadow deploy profile -------------------------------------
# The vm_shadow deployment uses a separate, fail-closed profile. Do NOT use this
# repo-root file as the VM runtime source of truth; the droplet env lives at
# /opt/hermes/secrets/hermes.vm_shadow.env (chmod 600, never committed). See the
# committed template infra/hermes.vm_shadow.env.example. The vm_shadow profile is:
#   APP_ENV=vm_shadow
#   BROKER_MODE=none
#   SUBMISSION_ENABLED=false / PAPER_SUBMIT_ENABLED=false / LIVE_SUBMIT_ENABLED=false
#   MARKET_DATA_ENABLED=true / CANDIDATE_GENERATION_ENABLED=true
#   GATEWAY_ENABLED=true / ORDER_TICKETING_ENABLED=true
#   HERMES_AUDIT_DB=/opt/hermes/data/audit.db
#   HERMES_HEARTBEAT_FILE=/opt/hermes/logs/heartbeat.txt
